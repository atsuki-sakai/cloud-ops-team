# cloud-ops-team configuration. Copy to .env for local development.
# On Cloud Run these are set by scripts/gcp/deploy_cloud_run.sh (never upload .env).

# ---- LLM (Gemini on Vertex AI by default) ---------------------------------
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id      # project that runs the model
GOOGLE_CLOUD_LOCATION=global
# Or use the Gemini API instead of Vertex AI: comment the three lines above and set
# GEMINI_API_KEY=your-api-key
# OPS_MODEL=gemini-3.8-flash                  # model for all agents
# OPS_RESEARCH_MODEL=gemini-3.8-flash         # model for web threat research (needs Google Search grounding)

# ---- What to operate -------------------------------------------------------
OPS_CLOUD_PROVIDER=gcp                        # gcp | aws | azure (aws/azure are skeletons, see docs/providers.md)
OPS_TARGET=your-target-project-id             # GCP project / AWS account id / Azure subscription id
OPS_TARGET_REGION=asia-northeast1
GITHUB_REPO=owner/repo                        # where issues and PRs live
# GITHUB_TOKEN=                               # unset: `gh auth token` is used locally

# GCP API auth: adc (default; runtime service account on Cloud Run, `gcloud auth application-default login`
# locally) or gcloud (borrow `gcloud auth print-access-token` when ADC belongs to another account)
OPS_GCP_AUTH=adc

# ---- Safety ----------------------------------------------------------------
OPS_DRY_RUN=true                              # true: never write to GitHub, return previews instead
OPS_AUTO_CLOSE_ISSUES=false                   # true: the weekly review closes verified issues itself
OPS_MAX_ISSUES_PER_RUN=10                     # cap on new issues per run

# ---- Optional execution history (private persistent local storage) ----------
# Unset: current in-memory execution behaviour. Set: fail closed on storage failure.
# The private parent directory and all ancestors must satisfy the storage policy.
# OPS_EXECUTION_DB_PATH=/srv/cloud-ops-private/history.sqlite3
# OPS_EXECUTION_MAX_EVIDENCE_BYTES=8388608     # maximum per protected evidence body
# OPS_EXECUTION_RETENTION_SECONDS=2592000     # 30 days; schedule purge_expired separately
# Cloud Run deployment does not provision durable storage or forward these settings.

# ---- Behaviour -------------------------------------------------------------
OPS_REPORT_LANGUAGE=ja                        # ja | en  (reports, issues and comments)
OPS_ERROR_LOOKBACK_HOURS=24                   # default error-watch window (match it to the schedule)
OPS_RECURRENCE_COOLDOWN_HOURS=24              # at most one recurrence comment per issue in this window
OPS_TIMEZONE=Asia/Tokyo
# OPS_STACK_KEYWORDS=Cloud Run,Cloud SQL,PostgreSQL,Node.js,Next.js   # filter for CISA KEV / threat research

# ---- Scheduled reviews (applied by make gcp-schedule) ------------------------
# Access investigation is a periodic review, not real-time detection/blocking.
ACCESS_WATCH_CRON="30 8 * * *"                # daily at 08:30
ACCESS_WATCH_HOURS=24                         # keep at least as long as the interval
INFRASTRUCTURE_REVIEW_CRON="0 10 * * 1"        # Mondays at 10:00
TZ_NAME=Asia/Tokyo                            # scheduler time zone; OPS_TIMEZONE formats reports

# ---- Fit your repository ---------------------------------------------------
# Extra labels on the team's issues (besides ops-agent / ops:*). Empty value = none.
# OPS_ERROR_LABELS=bug
# OPS_SECURITY_LABELS=security
# OPS_SEVERITY_LABELS=critical=severity: critical,high=severity: high,medium=severity: medium,low=severity: low
# Project knowledge for the agents (copy config/ops-context.example.md)
# OPS_CONTEXT_FILE=config/ops-context.md
