# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# ---- gcp-ops-team: 運用対象 ----------------------------------------------
# 監視・診断対象の GCP プロジェクトとリージョン（LLM を動かすプロジェクトと別でもよい）
GCP_TARGET_PROJECT=your-target-project-id
GCP_TARGET_REGION=asia-northeast1
# GCP API の認証: adc（既定。デプロイ時はランタイム SA、ローカルは gcloud auth application-default login）
# ローカルで ADC が別アカウントの場合は gcloud にすると `gcloud auth print-access-token` を使う
OPS_GCP_AUTH=adc
# ISSUE / PR を扱う GitHub リポジトリ
GITHUB_REPO=owner/repo
# GitHub トークン。未設定ならローカルでは `gh auth token` を使う。
# デプロイ時は Secret Manager から環境変数として注入する（repo スコープ / Issues: write, Pull requests: read, Actions: read, Contents: read）
# GITHUB_TOKEN=

# ---- gcp-ops-team: 安全弁 ----------------------------------------------
# true の間は GitHub への書き込み（ISSUE 作成・コメント・ラベル）を行わず、「起票予定」として返す
OPS_DRY_RUN=true
# true にすると週次レビューで検証済み ISSUE を実際にクローズする（既定: ラベル + コメントのみ）
OPS_AUTO_CLOSE_ISSUES=false
# 1 回の実行で起票する ISSUE の上限（暴走防止）
OPS_MAX_ISSUES_PER_RUN=10
# エラー監視の既定の遡り時間
OPS_ERROR_LOOKBACK_HOURS=24
# 同じエラーの open ISSUE に再発コメントを付ける最短間隔（時間）。毎時監視でも 1 日 1 コメントに抑える
OPS_RECURRENCE_COOLDOWN_HOURS=24
OPS_TIMEZONE=Asia/Tokyo
# 脅威動向（CISA KEV / Web 調査）の絞り込みに使う技術スタック
OPS_STACK_KEYWORDS=Cloud Run,Cloud SQL,PostgreSQL,Node.js,Next.js,Rust,Firebase,Stripe,Debian,Alpine,Linux
